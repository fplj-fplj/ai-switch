<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The compute pool has to keep answering while the app is in the background,
         and a foreground service is the only way Android allows a process to say
         that. `specialUse` rather than `dataSync`: Android 15 caps how long a
         dataSync service may run per day, which is the opposite of what a
         long-lived local gateway needs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13 and up hide notifications without this, which would leave the
         service running with nothing to show the user. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Asking to be exempted from battery optimisation. On its own this covers
         stock Android; the vendor pages below are how most Chinese ROMs are
         actually dealt with. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Package visibility (Android 11+). The keep-alive guidance probes each
         vendor's settings activities in turn, and without these declared the
         probe cannot see them at all: every candidate looks absent and the
         guidance silently degrades to the generic app-details page, which is the
         one page that does not solve the problem. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.lenovo.powersetting" />
        <package android:name="com.evenwell.powersaving.g3" />
    </queries>


    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ai_switch"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ComputePoolService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Required by the platform whenever `specialUse` is declared. It is
                 what a Play reviewer would read; this app is sideloaded, but the
                 declaration has to be valid either way. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the local AI gateway reachable while the app is in the background." />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
